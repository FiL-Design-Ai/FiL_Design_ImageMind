{
  "name": "fil-design-imagemind-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 + TypeScript frontend for the FiL Design ImageMind ComfyUI custom node pack.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "gen:contracts": "node scripts/gen_contracts.mjs"
  },
  "dependencies": {
    "pinia": "^2.2.4",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@types/node": "^22.5.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.9.1",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^24.1.1",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.0.29"
  }
}
