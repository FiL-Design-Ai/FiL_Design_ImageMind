{
  "name": "fil-design-imagemind-frontend",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "Vue 3 + TypeScript frontend for the FiL Design ImageMind ComfyUI custom node pack.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/sourceHash.mjs --write",
    "build:watch": "vite build --watch",
    "check:bundle": "node scripts/sourceHash.mjs --check",
    "check:contracts": "node scripts/gen_contracts.mjs --check",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -c playwright.comfy.config.ts",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e && npm run build",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "gen:contracts": "node scripts/gen_contracts.mjs",
    "scan:comfy-vars": "node scripts/scanComfyCssVars.mjs"
  },
  "dependencies": {
    "pinia": "^4.0.2",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.0"
  }
}
