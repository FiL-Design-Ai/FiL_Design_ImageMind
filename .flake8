[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    venv,
    .venv,
    _archive,
    .kilo,
    .pi,
    .qwen,
    .fil_cache,
    logs,
    web,
    tests/fixtures
ignore =
    E501,
    W503,
    W504,
    F403,
    F405
per-file-ignores =
    nodes/shared.py: F401
    tests/*.py: E402
    tools/problem_log.py: E402
